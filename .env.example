# SMTP usado pelo disparo de orçamentos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario
SMTP_PASSWORD=sua-senha
SMTP_FROM=orcamentos@example.com

# Wachat.me usado para envio dos códigos de acesso do cliente
WACHAT_API_URL=https://api.wachat.me/api/v1
WACHAT_API_TOKEN=seu-token-do-wachat
# Análise de produto por imagem
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_PRODUCT_MODEL=gpt-4o-mini
OPENAI_PRODUCT_TIMEOUT_MS=45000
AI_PRODUCT_ANALYSIS_PER_HOUR=20
