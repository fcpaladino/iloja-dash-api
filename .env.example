# SMTP usado pelo disparo de orçamentos
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-usuario
SMTP_PASSWORD=sua-senha
SMTP_FROM=orcamentos@example.com

# Wachat.me usado para envio dos códigos de acesso do cliente
WACHAT_API_URL=https://api.wachat.me/api/v1
WACHAT_API_TOKEN=seu-token-do-wachat

# OAuth Google
SESSION_SECRET=defina-um-segredo-de-sessao
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
GOOGLE_CALLBACK_URL=http://localhost:9292/google/auth/redirect
